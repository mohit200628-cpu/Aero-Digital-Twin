{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start Digital Twin Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run Backend Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/test_backend.py",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
